# ======================
frontend/.env
frontend/.env.*
!frontend/.env.example

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# Build files
frontend/build/
frontend/dist/

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

